{
  "name": "dsh-plugin-kunming-dialect",
  "version": "0.2.0",
  "description": "A DeepSeek Harness plugin for rewriting chatbot responses into authentic Kunming dialect using locally imported dictionaries.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "evaluate": "powershell -NoProfile -File scripts/evaluate.ps1",
    "audit:public": "python scripts/audit_public.py",
    "evaluate:v02": "powershell -NoProfile -File scripts/evaluate-v02.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiceNature333/dsh-plugin-kunming-dialect.git"
  },
  "homepage": "https://github.com/NiceNature333/dsh-plugin-kunming-dialect"
}
